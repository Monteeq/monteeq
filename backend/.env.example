# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=your-secret-key-here
REDIS_URL=rediss://default:password@redis.example.com:443

# Gemini API (editing feedback)
GEMINI_API_KEY=your-gemini-api-key

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=monteeq
AWS_S3_REGION_NAME=eu-central-1
AWS_CLOUDFRONT_DOMAIN=cdn.example.com
STORAGE_MODE=s3

# Auth
GOOGLE_CLIENT_ID=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# URLs
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
RUST_SERVICE_URL=http://127.0.0.1:7860

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Monteeq

# Payment
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=hello@example.com
